-- Every mutant is structurally accepted...
mutant-delta-structurally-accepted :
  decode-check-nats mutant-delta-wrong-body-v1 ≡ just true
mutant-delta-structurally-accepted = refl

mutant-beta-structurally-accepted :
  decode-check-nats mutant-beta-wrong-result-v1 ≡ just true
mutant-beta-structurally-accepted = refl

mutant-lookup-structurally-accepted :
  decode-check-nats mutant-lookup-wrong-type-v1 ≡ just true
mutant-lookup-structurally-accepted = refl

mutant-result-structurally-accepted :
  decode-check-nats mutant-result-not-normalized-v1 ≡ just true
mutant-result-structurally-accepted = refl

-- ...and every mutant fails the semantic replay.
mutant-delta-semantically-rejected :
  decode-semantic-nats mutant-delta-wrong-body-v1 ≡ just false
mutant-delta-semantically-rejected = refl

mutant-beta-semantically-rejected :
  decode-semantic-nats mutant-beta-wrong-result-v1 ≡ just false
mutant-beta-semantically-rejected = refl

mutant-lookup-semantically-rejected :
  decode-semantic-nats mutant-lookup-wrong-type-v1 ≡ just false
mutant-lookup-semantically-rejected = refl

mutant-result-semantically-rejected :
  decode-semantic-nats mutant-result-not-normalized-v1 ≡ just false

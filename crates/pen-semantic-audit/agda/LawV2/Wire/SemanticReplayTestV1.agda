  decode-semantic-nats mutant-delta-wrong-body-v1 ≡ just false
mutant-delta-semantically-rejected = refl

mutant-beta-semantically-rejected :
  decode-semantic-nats mutant-beta-wrong-result-v1 ≡ just false
mutant-beta-semantically-rejected = refl

mutant-lookup-semantically-rejected :
  decode-semantic-nats mutant-lookup-wrong-type-v1 ≡ just false

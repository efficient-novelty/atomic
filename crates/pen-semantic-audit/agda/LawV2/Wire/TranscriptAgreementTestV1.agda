-- The Agda rendering of the canonical bundle equals the pinned Rust
-- rendering byte-for-byte.
render-transcript-nats : List Nat → Maybe (List Byte)
render-transcript-nats values =
  maybe-bind (bytes-from-nats values) (λ bytes →
  maybe-bind (decode-production-bundle-v1 bytes) (λ bundle →
  render-canonical-transcript bundle))

transcript-agrees :
  render-transcript-nats canonical-vector-v1
  ≡ bytes-from-nats canonical-transcript-v1
transcript-agrees = refl

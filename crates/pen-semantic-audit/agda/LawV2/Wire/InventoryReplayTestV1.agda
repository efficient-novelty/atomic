{-# OPTIONS --safe --without-K #-}

-- Phase F inventory vectors.
--
-- The canonical fixture passes the whole-bundle inventory verdict by
-- refl, its six family payloads decode to genuine `Family` values
-- whose code tags are pinned, and the fixture's fresh computation
-- rule `uelim b unit = b` is demonstrated as a genuine abstract
-- fresh-equation step instance. Eight mutants are each structurally
-- valid AND accepted by the semantic replay AND accepted by the
-- typing verdict - sections 9 and 11 are invisible to those layers -
-- while the inventory layer rejects each for exactly one named
-- reason:
--
-- - `mutant-fresh-ill-typed-v1`: the rule's recorded type is `Sort 0`,
--   so neither side checks against it;
-- - `mutant-fresh-owner-bodyful-v1`: the old fixture shape, whose
--   owner slot 0 is a bodyful (delta-enabled) declaration;
-- - `mutant-fresh-duplicate-pair-v1`: two rules for one
--   `(owner, constructor)` pair under distinct equation ids;
-- - `mutant-seed-subject-mismatch-v1`: the old degenerate seed whose
--   subject is `Unit` rather than its public head;
-- - `mutant-seed-type-convertible-v1`: a seed type that is merely
--   convertible (a beta redex normalizing to the declared type), which
--   every typing layer accepts but the exact-declared-type discipline
--   rejects;
-- - `mutant-application-subject-mismatch-v1`: an application family
--   whose subject applies a different (but equally typed) argument
--   than its component's subject;
-- - `mutant-application-context-mismatch-v1`: an application family
--   judged in a different context than its components;
-- - `mutant-action-type-changed-v1`: an equation action recording a
--   coherent but different judgment, breaking type preservation
--   against its source family.
--
-- Development regression vectors, not correspondence authority.

module LawV2.Wire.InventoryReplayTestV1 where

open import Agda.Builtin.Bool using (Bool; false; true)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)
open import Agda.Builtin.Maybe using (Maybe; just; nothing)
open import Agda.Builtin.Nat using (Nat; zero; suc)
open import LawV2.Wire.Bytes
open import LawV2.Wire.ProductionBundleV1
open import LawV2.LambdaUnit.ProductionSyntaxV1
  using (PVar; Tm; var; global; app; bound; free; Empty)
open import LawV2.LambdaUnit.SubstitutionReduction
  using (Step; fresh-equation-step)
open import LawV2.LambdaUnit.ProductionInventoryBridgeV1
  using (family-code)
open import LawV2.Wire.InventoryReplayV1
  using (inventory-check-bundle; FamilyEnvV1; decode-family-payloads;
         abstract-family-code-to-tag)
open import LawV2.Wire.BundleDecodeTestV1
  using (canonical-vector-v1; decode-check-nats)
open import LawV2.Wire.SemanticReplayTestV1
  using (decode-semantic-nats)
open import LawV2.Wire.TypingReplayTestV1
  using (decode-typing-nats)

decode-inventory-nats : List Nat → Maybe Bool
decode-inventory-nats values =
  maybe-bind (bytes-from-nats values) (λ bytes →
  maybe-bind (decode-production-bundle-v1 bytes) (λ bundle →
  just (inventory-check-bundle bundle)))

-- The genuine fixture passes the whole-bundle inventory verdict.
canonical-vector-inventory-accepted :
  decode-inventory-nats canonical-vector-v1 ≡ just true
canonical-vector-inventory-accepted = refl

-- The fixture's six family payloads decode to genuine `Family` values
-- whose code tags (newest first: equation action, application, seed,
-- application, seed, seed) are exactly the wire payload tags.
env-code-tags : FamilyEnvV1 zero → List Nat
env-code-tags [] = []
env-code-tags ((identifier , value) ∷ rest) =
  abstract-family-code-to-tag (family-code value) ∷
  env-code-tags rest

decode-family-codes-nats : List Nat → Maybe (List Nat)
decode-family-codes-nats values =
  maybe-bind (bytes-from-nats values) (λ bytes →
  maybe-bind (decode-production-bundle-v1 bytes) (λ bundle →
  maybe-bind
    (decode-family-payloads 4 zero (bundle-fresh-rules bundle) []
      (bundle-family-payloads bundle)) (λ env →
  just (env-code-tags env))))

canonical-family-codes-decoded :
  decode-family-codes-nats canonical-vector-v1
  ≡ just (2 ∷ 1 ∷ 0 ∷ 1 ∷ 0 ∷ 0 ∷ [])
canonical-family-codes-decoded = refl

-- The fixture's fresh computation rule as a genuine abstract step:
-- matching the branch parameter to `global 0` (and the scrutinee
-- variable to the constructor head `global 1`) instantiates
-- `uelim b unit = b` as exactly the rewrite the saturated application
-- family's equation action records: its source subject
-- `(uelim global-0) global-1` steps to its subject `global 0`.
uelim-demo-match : PVar 2 → Tm Empty
uelim-demo-match bound = global 0
uelim-demo-match (free bound) = global 1

uelim-computation-step :
  Step {Empty}
    (app (app (global 3) (global 0)) (global 1))
    (global 0)
uelim-computation-step =
  fresh-equation-step
    (app (app (global 3) (var bound)) (global 1))
    (var bound)
    uelim-demo-match

